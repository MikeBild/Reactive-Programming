{
  "name": "reactive-programming-rxjs",
  "version": "1.0.0",
  "private": true,
  "description": "Übungen zum Workshop Reactive Programming mit RxJS",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test exercises/rx-marble-testing/search.test.ts && vitest run",
    "test:watch": "vitest",
    "test:marble": "node --test exercises/rx-marble-testing/search.test.ts",
    "test:marble:solution": "node --test exercises/rx-marble-testing/solution/search.test.ts",
    "test:solution": "RX_TARGET=solution vitest run && npm run test:marble:solution",
    "check": "tsc --noEmit && npm run test:solution"
  },
  "dependencies": {
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
